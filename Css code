body{
 font-family: Arial, sans-serif;
 background: #f4f4f4;
 margin:0;
}
.container{
 width:80%;
 max-width:800px;
 margin:20px auto;
 background:white;
 padding:30px;
 border-radius:10px;
 box-shadow: 0 0 10px rgba(0,0,0,0.1);
}
h1{ text-align:center; color:#2c3e50; }
h2{ color:#2980b9; border-bottom:2px solid #2980b9; padding-bottom:5px; }
h3{ text-align:center; color:#555; font-size:16px; }
footer{ text-align:center; margin-top:30px; border-top:1px solid #ccc; color:#777; }